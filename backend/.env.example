# ─── HPMS Backend Environment Configuration Example ─────────────────────────
# Copy this file to .env for local development. NEVER commit real production secrets!

# Application Server Port
PORT=8000

# Application Environment: development | test | production
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas cluster)
MONGO_URI=mongodb://localhost:27017/hpms

# JSON Web Token Secret Key (Must be at least 32 characters in production)
JWT_SECRET=dev_jwt_secret_key_change_in_production_12345

# JWT Token Expiration Duration
JWT_EXPIRES_IN=7d

# Configurable CORS Allowed Origin (e.g., http://localhost:3000 or production domain)
CORS_ORIGIN=http://localhost:3000
