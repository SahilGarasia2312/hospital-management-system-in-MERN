# ─── HPMS Frontend Environment Configuration Example ────────────────────────
# Copy this file to .env or .env.local for local development.

# Backend REST API Base URL
# In development: http://localhost:8000/api/v1
# In production: https://your-backend-domain.com/api/v1
REACT_APP_API_URL=http://localhost:8000/api/v1
